{
  "name": "licenseye",
  "version": "2.0.4",
  "description": "Node.js CLI tool to visualize an aggregate list of your dependencies' licenses Edit Add topics",
  "main": "dist.js",
  "repository": "git@github.com:lirantal/licenseye.git",
  "author": "Liran Tal <liran.tal@gmail.com>",
  "license": "MIT",
  "keywords": [
    "licenses",
    "license",
    "cli",
    "shell"
  ],
  "scripts": {
    "test": "npm run build && node --test",
    "lintFix": "npm run lint:fix",
    "start": "node index.js",
    "build": "babel index.js -o dist.js",
    "prepublishOnly": "npm run build",
    "lint": "standard index.js histogram.js test/*.js",
    "lint:fix": "standard index.js histogram.js test/*.js --fix",
    "version": "changeset version",
    "release": "changeset publish",
    "release:create": "changeset"
  },
  "bin": {
    "licenseye": "./dist.js"
  },
  "dependencies": {
    "babel-cli": "^6.26.0",
    "babel-core": "^6.26.0",
    "chalk": "^6.0.1",
    "figures": "^6.1.0",
    "licensewatch": "^2.0.1",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "babel-preset-env": "^1.6.0",
    "standard": "^11.0.0",
    "@changesets/cli": "^2.31.0",
    "@changesets/changelog-github": "^0.6.0"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.10.0"
  },
  "packageManager": "npm@11.17.0",
  "files": [
    "dist.js",
    "index.js",
    "histogram.js"
  ]
}
